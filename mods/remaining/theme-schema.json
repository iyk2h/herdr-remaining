{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Remaining theme",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "layout"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 200
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[^\\x00-\\x1f]+$"
    },
    "layout": {
      "type": "string",
      "enum": [
        "bars",
        "rings"
      ]
    },
    "show": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "short": {
          "type": "boolean",
          "default": true
        },
        "weekly": {
          "type": "boolean",
          "default": true
        },
        "badge": {
          "type": "boolean",
          "default": true
        }
      },
      "not": {
        "required": [
          "short",
          "weekly"
        ],
        "properties": {
          "short": {
            "const": false
          },
          "weekly": {
            "const": false
          }
        }
      }
    },
    "sizes": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "font": {
          "type": "number",
          "minimum": 10,
          "maximum": 14,
          "default": 12
        },
        "rowPadding": {
          "type": "number",
          "minimum": 0,
          "maximum": 6,
          "default": 2
        },
        "gap": {
          "type": "number",
          "minimum": 3,
          "maximum": 10,
          "default": 6
        },
        "badge": {
          "type": "number",
          "minimum": 14,
          "maximum": 20,
          "default": 16
        },
        "bar": {
          "type": "number",
          "minimum": 1,
          "maximum": 5,
          "default": 3
        },
        "ring": {
          "type": "number",
          "minimum": 20,
          "maximum": 28,
          "default": 24
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "text": {
          "type": "string",
          "pattern": "^(profile|foreground|muted|dim|accent|working|blocked|border|chrome|ansi(?:[0-9]|1[0-5])|#[0-9a-fA-F]{6})$",
          "default": "foreground"
        },
        "secondary": {
          "type": "string",
          "pattern": "^(profile|foreground|muted|dim|accent|working|blocked|border|chrome|ansi(?:[0-9]|1[0-5])|#[0-9a-fA-F]{6})$",
          "default": "muted"
        },
        "fill": {
          "type": "string",
          "pattern": "^(profile|foreground|muted|dim|accent|working|blocked|border|chrome|ansi(?:[0-9]|1[0-5])|#[0-9a-fA-F]{6})$",
          "default": "profile"
        },
        "track": {
          "type": "string",
          "pattern": "^(profile|foreground|muted|dim|accent|working|blocked|border|chrome|ansi(?:[0-9]|1[0-5])|#[0-9a-fA-F]{6})$",
          "default": "border"
        },
        "warning": {
          "type": "string",
          "pattern": "^(profile|foreground|muted|dim|accent|working|blocked|border|chrome|ansi(?:[0-9]|1[0-5])|#[0-9a-fA-F]{6})$",
          "default": "working"
        },
        "exhausted": {
          "type": "string",
          "pattern": "^(profile|foreground|muted|dim|accent|working|blocked|border|chrome|ansi(?:[0-9]|1[0-5])|#[0-9a-fA-F]{6})$",
          "default": "blocked"
        }
      }
    }
  }
}
